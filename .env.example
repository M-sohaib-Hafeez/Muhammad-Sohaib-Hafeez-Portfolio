# Contact form email delivery (https://www.emailjs.com/)
# Copy this file to .env, fill in your own EmailJS credentials, then add
# the same three variables in your Vercel project's Environment Variables.
# Until these are set, the contact form falls back to opening the
# visitor's email client with a pre-filled mailto: link.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
